-- JUMP SLIDER (16–200)
------------------------------------------------

local jLabel = Instance.new("TextLabel")
jLabel.Size = UDim2.new(1,-10,0,20)
jLabel.Position = UDim2.new(0,5,0,335)
jLabel.BackgroundTransparency = 1
jLabel.TextColor3 = Color3.new(1,1,1)
jLabel.Text = "Jump: 50"
jLabel.Parent = frame

local jBar = Instance.new("Frame")
jBar.Size = UDim2.new(1,-20,0,8)
jBar.Position = UDim2.new(0,10,0,360)
jBar.BackgroundColor3 = Color3.fromRGB(60,60,60)
jBar.Parent = frame

local jFill = Instance.new("Frame")
jFill.Size = UDim2.new(0.2,0,1,0)
jFill.BackgroundColor3 = Color3.fromRGB(0,255,100)
jFill.Parent = jBar

local draggingJ = false

local function updateJ(x)
	local p = math.clamp((x - jBar.AbsolutePosition.X)/jBar.AbsoluteSize.X,0,1)
	jumpPowerValue = math.floor(16 + 184*p)
	jFill.Size = UDim2.new(p,0,1,0)
	jLabel.Text = "Jump: "..jumpPowerValue
	updateJump()
end

jBar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingJ = true updateJ(i.Position.X) end
end)

UserInputService.InputChanged:Connect(function(i)
	if draggingJ and i.UserInputType == Enum.UserInputType.MouseMovement then updateJ(i.Position.X) end
end)

UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingJ = false end
end)

------------------------------------------------
-- DRAG UI
------------------------------------------------

local dragging, dragStart, startPos

frame.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = i.Position
		startPos = frame.Position
	end
end)

UserInputService.InputChanged:Connect(function(i)
	if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
		local d = i.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
			startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)

UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)
