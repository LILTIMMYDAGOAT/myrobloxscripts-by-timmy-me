-- StarterPlayerScripts LocalScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

------------------------------------------------
-- SETTINGS
------------------------------------------------

local NORMAL_SPEED = 16
local FAST_SPEED = 1000

local fastMode = false
local infiniteJump = false
local noclip = false
local flying = false
local draggable = true

local teleportDistance = 200
local jumpPowerValue = 50

local noclipConnection
local flightConnection
local bodyVelocity

------------------------------------------------
-- GUI
------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "DevUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,240,0,520)
frame.Position = UDim2.new(0,20,0,20)
frame.BackgroundColor3 = Color3.fromRGB(70,70,70)
frame.BorderSizePixel = 0
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0,10)

------------------------------------------------
-- UI HELPERS
------------------------------------------------

local function style(b)
	b.BackgroundColor3 = Color3.fromRGB(100,100,100)
	b.TextColor3 = Color3.fromRGB(255,255,255)
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
end

local function makeButton(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-20,0,35)
	b.Position = UDim2.new(0,10,0,y)
	b.Text = text
	b.Parent = frame
	style(b)
	return b
end

------------------------------------------------
-- BUTTONS
------------------------------------------------

local flightBtn = makeButton("Flight: OFF", 10)
local jumpBtn = makeButton("Infinite Jump: OFF", 55)
local speedBtn = makeButton("Speed: OFF", 100)
local noclipBtn = makeButton("Noclip: OFF", 145)
local dragBtn = makeButton("Draggable: ON", 190)
local teleportBtn = makeButton("Teleport", 235)

------------------------------------------------
-- CHARACTER HELPERS
------------------------------------------------

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

------------------------------------------------
-- SPEED + JUMP
------------------------------------------------

local function updateSpeed()
	local hum = getHumanoid()
	if hum then
		hum.WalkSpeed = fastMode and FAST_SPEED or NORMAL_SPEED
	end
end

local function updateJump()
	local hum = getHumanoid()
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = math.clamp(jumpPowerValue, 16, 200)
	end
end

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	updateSpeed()
	updateJump()
end)

------------------------------------------------
-- SPEED
------------------------------------------------

speedBtn.MouseButton1Click:Connect(function()
	fastMode = not fastMode
	speedBtn.Text = fastMode and "Speed: ON" or "Speed: OFF"
	updateSpeed()
end)

------------------------------------------------
-- FLIGHT
------------------------------------------------

local function stopFlight()
	flying = false
	if flightConnection then flightConnection:Disconnect() end
	if bodyVelocity then bodyVelocity:Destroy() end
end

local function startFlight()
	local root = getRoot()
	if not root then return end

	flying = true

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(1e9,1e9,1e9)
	bodyVelocity.Parent = root

	flightConnection = RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		local dir = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end

		bodyVelocity.Velocity = (dir.Magnitude > 0) and dir.Unit * 60 or Vector3.zero
	end)
end

flightBtn.MouseButton1Click:Connect(function()
	if flying then stopFlight() else startFlight() end
	flightBtn.Text = flying and "Flight: ON" or "Flight: OFF"
end)

------------------------------------------------
-- INFINITE JUMP
------------------------------------------------

jumpBtn.MouseButton1Click:Connect(function()
	infiniteJump = not infiniteJump
	jumpBtn.Text = infiniteJump and "Infinite Jump: ON" or "Infinite Jump: OFF"
end)

UserInputService.JumpRequest:Connect(function()
	if infiniteJump then
		local hum = getHumanoid()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

------------------------------------------------
-- NOCLIP
------------------------------------------------

noclipBtn.MouseButton1Click:Connect(function()
	noclip = not noclip
	noclipBtn.Text = noclip and "Noclip: ON" or "Noclip: OFF"

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if noclip then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end

			for _,v in ipairs(char:GetDescendants()) do
				if v:IsA("BasePart") then
					v.CanCollide = false
				end
			end
		end)
	end
end)

------------------------------------------------
-- TELEPORT
------------------------------------------------

teleportBtn.MouseButton1Click:Connect(function()
	local root = getRoot()
	if root then
		root.CFrame += root.CFrame.LookVector * teleportDistance
	end
end)

------------------------------------------------
-- TELEPORT SLIDER
------------------------------------------------

local tLabel = Instance.new("TextLabel")
tLabel.Size = UDim2.new(1,-10,0,20)
tLabel.Position = UDim2.new(0,5,0,280)
tLabel.BackgroundTransparency = 1
tLabel.TextColor3 = Color3.new(1,1,1)
tLabel.Text = "Teleport: 200"
tLabel.Parent = frame

local tBar = Instance.new("Frame")
tBar.Size = UDim2.new(1,-20,0,8)
tBar.Position = UDim2.new(0,10,0,305)
tBar.BackgroundColor3 = Color3.fromRGB(60,60,60)
tBar.Parent = frame

local tFill = Instance.new("Frame")
tFill.Size = UDim2.new(0.2,0,1,0)
tFill.BackgroundColor3 = Color3.fromRGB(0,170,255)
tFill.Parent = tBar

local draggingT = false

local function updateT(x)
	local p = math.clamp((x - tBar.AbsolutePosition.X)/tBar.AbsoluteSize.X,0,1)
	teleportDistance = math.floor(50 + 950*p)
	tFill.Size = UDim2.new(p,0,1,0)
	tLabel.Text = "Teleport: "..teleportDistance
end

tBar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingT = true updateT(i.Position.X) end
end)

UserInputService.InputChanged:Connect(function(i)
	if draggingT and i.UserInputType == Enum.UserInputType.MouseMovement then updateT(i.Position.X) end
end)

UserInputService.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingT = false end
end)

